{% extends format == 'html' ? 'email/transactional/layout.html.twig' : 'email/transactional/layout.txt.twig' %}

{% set declaration = remboursement
    ? 'Je demande au Club Alpin de Lyon le remboursement de cette note de frais, limité au plafond décidé par le Comité Directeur.'
    : 'Je renonce au remboursement du montant de ces frais pour en faire don au Club Alpin de Lyon.' %}

{% block subject -%}
    Note de frais validée : {{ objet }}
{%- endblock %}

{% block inner_html %}
    <p>Bonjour,</p>
    <p>Cette note de frais est validée et vous est transmise.</p>
    <ul>
        <li><strong>Demandeur :</strong> {{ demandeur }}</li>
        <li><strong>Type :</strong> {{ type }}</li>
        <li><strong>Commission :</strong> {{ commission }}</li>
        <li><strong>Objet :</strong> {{ objet }}</li>
        <li><strong>{{ type == 'formation' ? 'Date de la formation' : "Date de l'achat" }} :</strong> {{ dateDepense }}</li>
    </ul>

    <h2>Dépenses</h2>
    <ul>
        {% for ligne in lignes %}
            <li>{{ ligne.montant }}{{ ligne.description ? ' - ' ~ ligne.description }}{% if ligne.justificatif %} (<a href="{{ ligne.justificatif }}">justificatif</a>){% endif %}</li>
        {% endfor %}
    </ul>
    <p>Total : {{ total }}<br>Remboursable : {{ remboursable }}</p>
    {% if avertissements %}
        <p><strong>À vérifier :</strong></p>
        <ul>
            {% for avertissement in avertissements %}
                <li>{{ avertissement }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <p>
        <strong>{{ remboursement ? 'Remboursement demandé.' : 'Don au club.' }}</strong>
        En envoyant, {{ demandeur }} a déclaré&nbsp;: «&nbsp;{{ declaration }}&nbsp;»
    </p>
    <p>Validée par {{ valideePar }} le {{ valideeLe }}.</p>
    <p>Libellé de saisie : {{ libelleSaisie }}</p>
    <p>
        <a href="{{ lien }}" style="display: inline-block; padding: 8px 16px; border-radius: 6px; background-color: #0369a1; color: #ffffff; font-weight: bold; text-decoration: none;">Voir la demande</a>
    </p>
{% endblock %}

{% block inner_txt %}
Bonjour,

Cette note de frais est validée et vous est transmise.

- Demandeur : {{ demandeur }}
- Type : {{ type }}
- Commission : {{ commission }}
- Objet : {{ objet }}
- {{ type == 'formation' ? 'Date de la formation' : "Date de l'achat" }} : {{ dateDepense }}

DÉPENSES
{% for ligne in lignes %}
- {{ ligne.montant }}{{ ligne.description ? ' - ' ~ ligne.description }}{% if ligne.justificatif %} (justificatif : {{ ligne.justificatif }}){% endif %}

{% endfor %}

Total : {{ total }}
Remboursable : {{ remboursable }}
{% if avertissements %}

À vérifier :
{% for avertissement in avertissements %}
- {{ avertissement }}
{% endfor %}
{% endif %}

{{ remboursement ? 'Remboursement demandé.' : 'Don au club.' }} En envoyant, {{ demandeur }} a déclaré : « {{ declaration }} »

Validée par {{ valideePar }} le {{ valideeLe }}.

Libellé de saisie : {{ libelleSaisie }}

Voir la demande : {{ lien }}
{% endblock %}
