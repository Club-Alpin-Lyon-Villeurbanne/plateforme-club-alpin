{% extends format == 'html' ? 'email/transactional/layout.html.twig' : 'email/transactional/layout.txt.twig' %}

{# l'objet saisi par l'encadrant sert de sujet ; sans objet, on garde le sujet automatique #}
{% block subject -%}
    {% import 'macros/sujet-message-sortie.html.twig' as sujet %}
    {%- if objet is not empty %}{{ objet }}{% else %}{{ sujet.sujet_message_sortie(commission, name_sortie, date_sortie) }}{% endif %}
{%- endblock %}

{% block inner_html %}
    <p>
        Vous avez reçu un message de <a href="{{ message_author_url }}">{{ message_author }}</a> au sujet de la sortie <a href="{{ url_sortie }}">{{ name_sortie }}</a>.
    </p>
    <p>
        <b>Message :</b>
    </p>
    <p>
        {{ message | converturls | nl2br }}
    </p>
{% endblock %}

{% block inner_txt %}
Vous avez reçu un message de <a href="{{ message_author_url }}">{{ message_author }}</a> au sujet de la sortie <a href="{{ url_sortie }}">{{ name_sortie }}</a>.

Message :

{{ message }}
{% endblock %}
