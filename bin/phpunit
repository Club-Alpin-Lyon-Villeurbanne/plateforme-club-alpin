#!/usr/bin/env php
<?php

if (!ini_get('date.timezone')) {
    ini_set('date.timezone', 'UTC');
}

$phpunit = dirname(__DIR__).'/vendor/phpunit/phpunit/phpunit';

// PHPUnit est une dépendance Composer depuis le passage à PHPUnit 12. Un vendor/ installé avant
// ne l'a pas : l'ancien repli sur simple-phpunit lançait alors PHPUnit 9, et les tests échouaient
// sans rapport apparent avec Composer (ArgumentCountError sur les fournisseurs de données).
if (!is_file($phpunit)) {
    fwrite(STDERR, "PHPUnit n'est pas installé dans vendor/ : lancez « make composer-install », puis relancez les tests.\n");
    exit(1);
}

require $phpunit;
